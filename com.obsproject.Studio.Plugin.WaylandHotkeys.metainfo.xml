<?xml version="1.0" encoding="UTF-8"?>
<component type="addon">
  <id>com.obsproject.Studio.Plugin.WaylandHotkeys</id>
  <extends>com.obsproject.Studio</extends>
  <name>Wayland Hotkeys</name>
  <summary>Plugin for OBS Studio adding global shortcuts for Wayland Environments</summary>
  <description>
    <p>Adds global shortcuts support to desktop environments that implement the global shortcuts portal</p>
  </description>
