      <caption>OBS Open with the KDE Plasma shortcuts portal dialog asking to register the shortcuts</caption>
    </screenshot>
    <screenshot>
      <image>https://raw.githubusercontent.com/leia-uwu/obs-wayland-hotkeys/refs/heads/master/screenshots/2.png</image>
      <caption>OBS Shortcuts on KDE Plasma system settings Shortcuts page</caption>
    </screenshot>
  </screenshots>
  <developer id="io.github.leia-uwu">
    <name>Leia</name>
  </developer>
  <url type="homepage">https://github.com/leia-uwu/obs-wayland-hotkeys</url>
